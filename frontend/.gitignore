# ============================================
# Next.js Farm Management Frontend
# Optimized .gitignore for Standalone Repository
# ============================================

# ----------------------
# Dependencies
# ----------------------
node_modules/
.pnp/
.pnp.js
.yarn/

# ----------------------
# Next.js Build Output
# ----------------------
.next/
out/
build/
dist/

# ----------------------
# Environment Files
# NEVER commit actual env files with secrets
# ----------------------
.env
.env.local
.env.development.local
.env.test.local
.env.production.local

# Keep example files
!.env.example
!.env.production.example

# ----------------------
# Logs
# ----------------------
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# PM2 logs
pm2-error.log
pm2-out.log

# ----------------------
# Testing
# ----------------------
coverage/
.nyc_output/
*.lcov

# ----------------------
# TypeScript
# ----------------------
*.tsbuildinfo
next-env.d.ts

# ----------------------
# IDE / Editor
# ----------------------
.idea/
.vscode/*
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json
!.vscode/extensions.json
*.swp
*.swo
*~
.project
.classpath
.c9/
*.launch
.settings/
*.sublime-workspace

# ----------------------
# OS Files
# ----------------------
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
desktop.ini

# ----------------------
# Debug
# ----------------------
.debug/
debug.log

# ----------------------
# Misc
# ----------------------
*.pem
*.key
*.crt

# Vercel
.vercel/

# PWA generated files (if generated at build)
# public/sw.js
# public/workbox-*.js

# Sentry
.sentryclirc

# Storybook
storybook-static/

# Temporary files
tmp/
temp/
*.tmp
*.temp

# Bundle analyzer
.analyzer/

# Cache directories
.cache/
.parcel-cache/
.turbo/

# Local development
.local/
