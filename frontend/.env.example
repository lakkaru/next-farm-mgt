# ============================================
# FARM MANAGEMENT SYSTEM - NEXT.JS FRONTEND
# Environment Configuration Template
# ============================================
# Copy this file to .env.local for development
# ============================================

# ----------------------
# Application Settings
# ----------------------
NODE_ENV=development
NEXT_PUBLIC_APP_NAME="Farm Management System"
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ----------------------
# Backend API Configuration
# ----------------------
# The backend API URL (Express.js server)
NEXT_PUBLIC_API_URL=http://localhost:5000/api

# Internal API URL (for server-side requests within Docker/VPS)
API_INTERNAL_URL=http://localhost:5000/api

# ----------------------
# Authentication
# ----------------------
# JWT secret for token validation (should match backend)
JWT_SECRET=your_super_secure_jwt_secret_key_here

# ----------------------
# Cloudflare R2 Storage (for image URLs)
# ----------------------
# NEXT_PUBLIC_R2_PUBLIC_URL=https://images.yourdomain.com

# ----------------------
# Feature Flags
# ----------------------
NEXT_PUBLIC_ENABLE_DISEASE_DETECTION=true
NEXT_PUBLIC_ENABLE_MACHINERY_SERVICES=true
NEXT_PUBLIC_ENABLE_PWA=true

# ----------------------
# Analytics & Monitoring (optional)
# ----------------------
# NEXT_PUBLIC_GA_MEASUREMENT_ID=G-XXXXXXXXXX
# NEXT_PUBLIC_SENTRY_DSN=https://xxx@sentry.io/xxx

# ----------------------
# i18n Configuration
# ----------------------
NEXT_PUBLIC_DEFAULT_LOCALE=si
NEXT_PUBLIC_SUPPORTED_LOCALES=en,si
