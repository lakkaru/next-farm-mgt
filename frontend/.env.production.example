# ============================================
# FARM MANAGEMENT SYSTEM - NEXT.JS FRONTEND
# PRODUCTION Environment Configuration
# ============================================
# Copy this file to .env.production.local on your VPS
# NEVER commit .env.production.local to git
# ============================================

# ----------------------
# Application Settings
# ----------------------
NODE_ENV=production
NEXT_PUBLIC_APP_NAME="Farm Management System"
NEXT_PUBLIC_APP_URL=https://farm.yourdomain.com

# ----------------------
# Backend API Configuration
# ----------------------
# Production backend API URL
NEXT_PUBLIC_API_URL=https://api.yourdomain.com/api

# Internal API URL (for server-side requests)
# If backend is on same server, use localhost
API_INTERNAL_URL=http://localhost:5000/api

# ----------------------
# Authentication
# ----------------------
# JWT secret (MUST match backend .env)
JWT_SECRET=your_production_jwt_secret_here

# ----------------------
# Cloudflare R2 Storage
# ----------------------
NEXT_PUBLIC_R2_PUBLIC_URL=https://images.yourdomain.com

# ----------------------
# Feature Flags
# ----------------------
NEXT_PUBLIC_ENABLE_DISEASE_DETECTION=true
NEXT_PUBLIC_ENABLE_MACHINERY_SERVICES=true
NEXT_PUBLIC_ENABLE_PWA=true

# ----------------------
# Analytics & Monitoring
# ----------------------
# NEXT_PUBLIC_GA_MEASUREMENT_ID=G-XXXXXXXXXX
# NEXT_PUBLIC_SENTRY_DSN=https://xxx@sentry.io/xxx

# ----------------------
# i18n Configuration
# ----------------------
NEXT_PUBLIC_DEFAULT_LOCALE=si
NEXT_PUBLIC_SUPPORTED_LOCALES=en,si

# ----------------------
# Performance
# ----------------------
# Image optimization domain whitelist
NEXT_PUBLIC_IMAGE_DOMAINS=images.yourdomain.com,res.cloudinary.com
