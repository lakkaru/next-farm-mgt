# Environment Variables
NODE_ENV=development
PORT=5000

# MongoDB Atlas Configuration
# MONGODB_URI=mongodb+srv://username:password@cluster.mongodb.net/farm_management?retryWrites=true&w=majority

# JWT Secret
JWT_SECRET=your_super_secure_jwt_secret_key_here
JWT_EXPIRES_IN=7d

# Other configurations
CORS_ORIGIN=http://localhost:8000

# API Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100

# OpenAI Configuration
# Get your API key from: https://platform.openai.com/api-keys
OPENAI_API_KEY=your_openai_api_key_here

# Cloudflare R2 Storage Configuration
R2_ENDPOINT=https://your-account-id.r2.cloudflarestorage.com
R2_ACCESS_KEY_ID=your_r2_access_key_id
R2_SECRET_ACCESS_KEY=your_r2_secret_access_key
R2_ACCOUNT_ID=your_cloudflare_account_id
R2_BUCKET_NAME=farm-management-images
R2_AVATAR_BUCKET_NAME=avatar
# Optional: Custom domain URLs for public access
# R2_PUBLIC_URL=https://images.yourdomain.com
# R2_AVATAR_PUBLIC_URL=https://avatars.yourdomain.com
